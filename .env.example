# Copy to .env and fill in. .env is gitignored — never commit real values.

# ── Database ──────────────────────────────────────────────────────────────
# Neon connection string. Use the POOLED one (hostname contains "-pooler").
DATABASE_URL=

# ── Sessions ──────────────────────────────────────────────────────────────
# Signs the login cookie. 32+ chars.
SESSION_SECRET=

# ── Coordinator access ────────────────────────────────────────────────────
# Comma separated. These addresses get the admin view; everyone else gets the
# parent view. Remove an address to withdraw access, nothing else to change.
ADMIN_EMAILS=

# ── Email ─────────────────────────────────────────────────────────────────
# Sends the one-time login codes. Without this, codes print to the server
# console instead: fine locally, useless in production.
RESEND_API_KEY=
# Until the domain is verified at resend.com/domains this MUST stay as
# onboarding@resend.dev, and Resend delivers only to the account owner.
# After verifying nextgenkenya.com, change to e.g. swim@nextgenkenya.com
MAIL_FROM=NextGen Swim <onboarding@resend.dev>

# ── Error reporting (optional). Leave both blank and Sentry is off entirely:
# no SDK init, nothing sent. Add them to catch broken pages before a parent
# rings up about one.
#
# From sentry.io -> your project -> Settings -> Client Keys (DSN). The same DSN
# goes in both: the first is read by the server, the second by the browser.
# Nothing personal is sent either way — see src/lib/sentry.ts for exactly what
# is stripped.
SENTRY_DSN=
VITE_SENTRY_DSN=
