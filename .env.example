# Supabase — fill these in, then tell me. This file is gitignored.
# Project dashboard -> Settings -> API

# Project URL, e.g. https://abcdefgh.supabase.co
VITE_SUPABASE_URL=

# "anon / public" key — safe in the browser, RLS enforces access
VITE_SUPABASE_ANON_KEY=

# "service_role" key — BYPASSES RLS. Used only by the one-off import script,
# never by the app. Leave blank until the import step if you prefer.
SUPABASE_SERVICE_ROLE_KEY=
